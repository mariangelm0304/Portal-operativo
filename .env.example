# Variables de entorno del monorepo, solo como referencia rápida.
# Los valores reales de cada app viven en apps/api/.env y apps/web/.env
# (cada uno con su propio .env.example) — este archivo no se carga por código.

# --- apps/api ---
# DATABASE_URL=postgresql+psycopg://usuario:password@localhost:5432/portal_operativo
# JWT_SECRET=cambia-esto-por-un-valor-aleatorio-largo
# GOOGLE_SERVICE_ACCOUNT_JSON=./credenciales-google.json
# GOOGLE_SHEET_ID=

# --- apps/web ---
# VITE_API_URL=http://localhost:8000
