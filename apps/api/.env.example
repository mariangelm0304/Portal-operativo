ENVIRONMENT=development

# Postgres nativo en Windows: crea la base primero (ej. `createdb portal_operativo`)
DATABASE_URL=postgresql+psycopg://portal:tu_password@localhost:5432/portal_operativo

# Genera uno real con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-esto-por-un-valor-aleatorio-largo

CORS_ORIGINS=["http://localhost:5173"]

UPLOADS_DIR=./uploads
MAX_ARCHIVO_BYTES=15728640

PIN_ADMIN_DEFAULT=JAMAR2026

# Fase 6 (Sheets/Drive) — dejar vacío hasta tener la cuenta de servicio
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
